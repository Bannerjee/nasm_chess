%ifndef MACROSES 
%define MACROS_MAC 

SHADOW_SPACE equ 0x20

extern memcpy
extern memset
extern malloc
extern free

%macro LOWORD 1
and %1, 0xFFFF
%endmacro
%macro HIWORD 1
sar %1, 16
and %1, 0xFFFF
%endmacro
%macro prologue 1
	push rbp
	mov rbp,rsp
	sub rsp,%1
%endmacro
%macro epilogue 1
	add rsp,%1
    mov rsp,rbp
    pop rbp
    ret
%endmacro
%macro clear 1-*
	%rep %0
        xor %1, %1
        %rotate 1
    %endrep
%endmacro

%macro zeroOut 2 ; fill certain area of memory with 0
	lea rcx, [ %1 ]
	xor rdx, rdx
	mov r8, %2
	call memset
%endmacro

